default_platform(:ios)

# Load environment variables from .env file for local development
begin
  require 'dotenv'
  Dotenv.load
rescue LoadError
  # Dotenv not available, skip loading (CI environments provide env vars directly)
end

lane :test do
  setup
  scan(
    scheme: "BluePlaquesLondon",
    device: "iPhone 16 Pro",
    code_coverage: true
  )
end

lane :screenshots do
  snapshot
end

lane :setup do
  inject_firebase_api_key
  inject_google_maps_api_key
end

private_lane :inject_firebase_api_key do
  firebase_key = ENV['FIREBASE_API_KEY']
  UI.user_error!("FIREBASE_API_KEY environment variable is required") if firebase_key.nil? || firebase_key.empty?
  
  plist_path = "../BluePlaquesLondon/Resources/GoogleService-Info.plist"
  sh "plutil -replace API_KEY -string '#{firebase_key}' '#{plist_path}'"
  UI.success("Firebase API key injected successfully")
end

private_lane :inject_google_maps_api_key do
  maps_key = ENV['GOOGLE_MAPS_API_KEY']
  UI.user_error!("GOOGLE_MAPS_API_KEY environment variable is required") if maps_key.nil? || maps_key.empty?
  
  plist_path = "../BluePlaquesLondon/Resources/APIKeys.plist"
  sh "plutil -replace GoogleMapsAPIKey -string '#{maps_key}' '#{plist_path}'"
  UI.success("Google Maps API key injected successfully")
end

lane :cleanup do
  sh "plutil -replace API_KEY -string 'FIREBASE_API_KEY_PLACEHOLDER' '../BluePlaquesLondon/Resources/GoogleService-Info.plist'"
  sh "plutil -replace GoogleMapsAPIKey -string 'GOOGLE_MAPS_API_KEY_PLACEHOLDER' '../BluePlaquesLondon/Resources/APIKeys.plist'"
  UI.success("API keys reset to placeholders")
end

lane :quality do
  security_audit
  oclint_analysis
  coverage_check
end

private_lane :security_audit do
  sh "bundle exec bundle-audit check --update"
  UI.success("Security audit completed")
end

private_lane :oclint_analysis do
  sh "xcodebuild clean build -workspace BluePlaquesLondon.xcworkspace -scheme BluePlaquesLondon -configuration Debug | xcpretty -r json-compilation-database -o compile_commands.json"
  sh "oclint-json-compilation-database -v -- -report-type html -o oclint_report.html"
  UI.success("OCLint analysis completed")
end

private_lane :coverage_check do
  xcov(
    scheme: "BluePlaquesLondon",
    minimum_coverage_percentage: 0.0,  # Set to 0 to not fail, just report
    include_test_targets: false,
    output_directory: "test_output/coverage",
    html_report: true
  )
  UI.important("📊 Coverage report generated at test_output/coverage/index.html")
  UI.important("🎯 Target coverage: 70% (currently much lower - write more tests!)")
end

lane :build do
  gym(
    scheme: "BluePlaquesLondon",
    export_method: "development",
    xcargs: "-allowProvisioningUpdates"
  )
end

lane :beta do
  setup
  increment_build_number(xcodeproj: "BluePlaquesLondon.xcodeproj")
  gym(
    scheme: "BluePlaquesLondon",
    export_method: "app-store",
    xcargs: "-allowProvisioningUpdates"
  )
  upload_to_testflight(
    api_key: app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: "fastlane/api_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_KEY_ID']}.p8"
    ),
    changelog: "Bug fixes and improvements",
    skip_waiting_for_build_processing: true
  )
end

lane :release do
  setup
  increment_build_number(xcodeproj: "BluePlaquesLondon.xcodeproj")
  gym(
    scheme: "BluePlaquesLondon",
    export_method: "app-store",
    xcargs: "-allowProvisioningUpdates"
  )
  upload_to_app_store(
    api_key: app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_filepath: "fastlane/api_keys/AuthKey_#{ENV['APP_STORE_CONNECT_API_KEY_KEY_ID']}.p8"
    ),
    force: true,
    submit_for_review: false,
    precheck_include_in_app_purchases: false
  )
end
